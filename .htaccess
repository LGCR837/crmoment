# CRMoment - Apache Rewrite Rules（仅限 Apache 环境）
# 如果您使用 Nginx，请参考 nginx.conf 中的配置

RewriteEngine On

# 如果请求的是真实存在的文件或目录，直接访问
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# API 路由 — 明确处理 /app 和 /app/xxx 两种格式
RewriteRule ^app/(.*)$ api_index.php [QSA,L]

# 单独处理 /app 根路径（不加尾部斜杠），
# 因为 !-d 条件会阻止上面那条规则处理 /app 目录本身
RewriteRule ^app$ api_index.php [QSA,L]

# 设置上传文件缓存
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "max-age=2592000, public"
</FilesMatch>

# 禁止访问私有文件
<FilesMatch "\.(sql|md)$">
    Require all denied
</FilesMatch>
